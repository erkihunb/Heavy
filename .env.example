APP_NAME="TMA Heavy Vehicle Permits"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Timestamps are stored in UTC; this is the timezone they are displayed in.
APP_DISPLAY_TIMEZONE=Africa/Addis_Ababa

# Staff (reviewer, approver, cashier, traffic officer, admin) must use two-factor
# authentication. Only ever disable this for local development.
PERMITS_STAFF_TWO_FACTOR_REQUIRED=true

# An Approver decides only after a Reviewer's recommendation, and may not be that Reviewer.
PERMITS_TWO_STEP_APPROVAL=true
# Longest period one permit may cover (days) and most trailers it may list.
PERMITS_MAX_DURATION_DAYS=90
PERMITS_MAX_TRAILERS=2

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 is required. These values match the service in compose.yaml,
# which is published on host port 54320 (override with FORWARD_DB_PORT).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54320
DB_DATABASE=heavy
DB_USERNAME=heavy
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
