APP_NAME="TMA Heavy Vehicle Permits"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Timestamps are stored in UTC; this is the timezone they are displayed in.
APP_DISPLAY_TIMEZONE=Africa/Addis_Ababa

# Staff (reviewer, approver, cashier, traffic officer, admin) must use two-factor
# authentication. Only ever disable this for local development.
PERMITS_STAFF_TWO_FACTOR_REQUIRED=true

# An Approver decides only after a Reviewer's recommendation, and may not be that Reviewer.
PERMITS_TWO_STEP_APPROVAL=false
# Longest period one permit may cover (days) and most trailers it may list.
PERMITS_MAX_DURATION_DAYS=90
PERMITS_MAX_TRAILERS=2
# The person who approved a permit may not verify its payment.
PERMITS_SEPARATION_OF_DUTIES=true
# Private disk for payment receipts and permit documents; largest receipt file in KB.
PERMITS_DOCUMENTS_DISK=documents
PERMITS_RECEIPT_MAX_KB=5120
# Public HTTPS address printed in every QR code as <url>/v/<token>. Changing it breaks printed permits.
PERMITS_VERIFY_URL="${APP_URL}"
PERMITS_PUBLIC_SHOWS_ORGANIZATION=true
PERMITS_VERIFICATION_PER_MINUTE=30
# Official logo for the PDF header (absolute path); a placeholder is shown until set.
PERMITS_DOCUMENT_LOGO_PATH=
PERMITS_SUPPORT_EMAIL=
PERMITS_SUPPORT_PHONE=
# "gotenberg" (production) or "fake" (machines without Gotenberg; PDFs are empty placeholders).
PERMITS_PDF_RENDERER=gotenberg
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_TIMEOUT=60
# Notifications: e-mail to the organization's members, SMS to the organization's phone.
PERMITS_NOTIFY_MAIL=true
PERMITS_NOTIFY_SMS=true
# SMS provider: "log" (numbers masked in the log) or "http" (JSON to SMS_HTTP_URL with a bearer token).
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_SENDER=
# "Expires soon" reminder: days before the last day, and the time of day (Africa/Addis_Ababa).
PERMITS_EXPIRING_REMINDER_DAYS=7
PERMITS_EXPIRING_REMINDER_TIME=08:00
# Spreadsheet exports are deleted (file and record) after this many days.
PERMITS_EXPORTS_KEEP_DAYS=7
# Colour theme (navy, forest, sunset, graphite) and default mode (system, light, dark).
PERMITS_THEME=navy
PERMITS_DEFAULT_MODE=system
# Production password length and login attempts per minute.
PERMITS_PASSWORD_MIN_LENGTH=12
PERMITS_LOGIN_PER_MINUTE=5
# Telegram alerts to a staff group chat (also in System settings → Telegram).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reverse proxies in front of the app ("*" or a comma-separated list).
TRUSTED_PROXIES=
# Error tracking; off when empty. Personal data is never sent.
SENTRY_LARAVEL_DSN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 or MariaDB 10.4+. These values match the service in compose.yaml; point
# them at your own server if you have one. The test suite uses the same server
# but its own database, heavy_testing (create it once: CREATE DATABASE heavy_testing).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heavy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
