# Production environment for compose.production.yaml. Copy to .env.production
# (never committed), fill every value marked CHANGE, then follow README.md → Deploying.

APP_NAME="TMA Heavy Vehicle Permits"
APP_ENV=production
# CHANGE: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# CHANGE: the public HTTPS address
APP_URL=https://permits.example.gov.et
APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=Africa/Addis_Ababa

# The reverse proxy in front of the "web" container (TLS ends there). "*" trusts
# any proxy: use it only when the container is not reachable directly.
TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=heavy
DB_USERNAME=heavy
# CHANGE: long random passwords
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Longer than the longest job (exports: 30 minutes), so no job runs twice.
REDIS_QUEUE_RETRY_AFTER=1900

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# CHANGE
REDIS_PASSWORD=

# E-mail (can also be changed in System settings → E-mail).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.gov.et"
MAIL_FROM_NAME="${APP_NAME}"

# Mandatory for staff (spec §15).
PERMITS_STAFF_TWO_FACTOR_REQUIRED=true
PERMITS_VERIFY_URL="${APP_URL}"
PERMITS_DOCUMENTS_DISK=documents
PERMITS_PDF_RENDERER=chrome
CHROME_BINARY=/usr/bin/google-chrome
CHROME_TIMEOUT=60

# SMS and Telegram can be set in System settings.
SMS_DRIVER=log

# Error tracking (spec §16). Personal data is never sent.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Backups (backup service): retention, time of day (UTC) and where on the host.
BACKUP_RETENTION_DAYS=30
BACKUP_AT=00:00
BACKUP_PATH=./backups

# Where nginx listens on the host (the reverse proxy forwards here).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
